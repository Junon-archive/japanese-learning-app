# 이 파일을 repo 루트에 `.env`로 복사해서 값을 채운다. .env는 Git에 넣지 않는다.
# docker compose도 루트의 .env를 읽는다 (Makefile이 --env-file .env로 지정한다).
# 실제 값·실제 도메인·실제 credential을 이 파일에 적지 않는다.
# 애플리케이션은 .env를 직접 읽지 않는다(테스트 결정론). docker compose는
# .env를 읽고, 로컬 실행 시에는 셸에서 export 한다.

# local | development | production
# /docs, /redoc, /openapi.json은 development일 때만 열린다.
APP_ENV=local

# postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# 비워두면 /api/health의 database 상태가 unknown이 된다.
DATABASE_URL=

# 허용할 frontend origin의 쉼표 구분 목록. wildcard(*)는 허용하지 않는다.
# 비워두면 허용 origin이 0개다. 배포 도메인은 운영자가 정해 .env에만 적고
# 저장소 파일에는 적지 않는다 (infra/DEPLOY.md, ADR-020 결정 6).
CORS_ALLOW_ORIGINS=http://localhost:5173

# auth session cookie 수명(일, 양의 정수). cookie 이름/속성은 코드 고정이고
# 환경별 스위치가 없다 (ADR-004).
AUTH_SESSION_TTL_DAYS=30

# 학습 정책 YAML 경로 override.
# docker compose(production)에서는 필수다. /etc/nihongo-context/config.yaml을
# 가리킨다. compose가 이 경로를 호스트와 컨테이너에 같은 절대경로로 read-only mount
# 하며, 값이 비어 있으면 compose의 모든 명령(make db-up 포함)이 실패한다.
# 그 파일은 config/default.yaml의 전체 사본이고 daily_request_limit /
# daily_token_limit 두 줄만 다르다. 저장소 작업 트리 밖에 두며 Git에 넣지 않는다.
# compose 밖(호스트에서 직접 실행)에서만 비워둘 수 있고, 그때는 config/default.yaml을 쓴다.
# 사용량 한도 경고 (spec/mvp-01-core/14_CONFIGURATION.md의 production override):
#   - 한도 값을 바꾸면 worker를 재시작해야 반영된다 (config는 기동 시 한 번 읽는다).
#   - 하루는 UTC 기준이라 한도는 한국시간 오전 9시에 리셋된다.
#   - 0이나 음수는 한도를 끄는 값이 아니다. 생성을 영구히 멈춘다. 끄려면 null이다.
#   - 두 키를 모두 설정한다. 하나만 두면 나머지는 꺼진 한도다.
NC_CONFIG_PATH=

# LLM provider 구현 선택. MVP 허용값은 openai 하나이고 기본값이 없다.
# 값이 없거나 허용값이 아니면 worker가 부팅에 실패한다(fail-closed).
# mock을 가리키는 값은 없다. 실제 키 없이 generation 경로를 도는 것은
# 테스트가 worker loop에 test double을 주입해서 한다
# (spec/04_SECURITY_AND_DATA.md, ADR-016의 개정 절).
# 모델명은 여기가 아니라 prompt_versions 행에서 온다.
# API 프로세스는 이 값을 쓰지 않는다. worker에만 준다.
LLM_PROVIDER=

# provider secret. LLM_PROVIDER=openai일 때 필수이며 worker 프로세스에만 준다.
# FastAPI 프로세스는 provider client를 만들지 않으므로 이 값이 필요 없다.
LLM_API_KEY=

# infra/docker-compose.yml용
POSTGRES_DB=
POSTGRES_USER=
# password는 영숫자 난수로 만든다(예: openssl rand -hex 24). compose가 $를 변수로 읽어 조용히 지우고, DATABASE_URL에서는 @ # / : 를 인코딩해야 한다.
POSTGRES_PASSWORD=
