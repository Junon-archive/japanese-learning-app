FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/usr/local

# uv 버전을 고정한다. uv.lock의 해시 고정은 lock을 해석하는 바이너리가
# 고정되어야 의미가 있다. digest 고정은 배포 환경에서 수행한다.
COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /usr/local/bin/uv

WORKDIR /app

# 의존성 설치까지는 root, 실행은 비특권 사용자. site-packages도 앱 소스도
# root 소유로 두어 런타임 사용자가 덮어쓸 수 없게 한다
# (spec/04_SECURITY_AND_DATA.md).
COPY pyproject.toml uv.lock ./
# 기본 group(dev, furigana) 없이 sync한다. API는 분석기를 import하지 않는다(ADR-021 결정 6).
# `--no-dev`로는 furigana group이 빠지지 않는다. `--no-build`: sdist를 빌드하지 않고 wheel만 설치한다.
RUN uv sync --frozen --no-default-groups --no-build

RUN useradd --create-home --uid 10001 appuser

COPY backend ./backend
COPY config ./config

USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8000"]
