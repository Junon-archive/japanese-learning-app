FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/usr/local

# uv 버전을 고정한다. uv.lock의 해시 고정은 lock을 해석하는 바이너리가
# 고정되어야 의미가 있다. digest 고정은 배포 환경에서 수행한다.
COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /usr/local/bin/uv

WORKDIR /app

# 의존성 설치까지는 root, 실행은 비특권 사용자. site-packages도 앱 소스도
# root 소유로 두어 런타임 사용자가 덮어쓸 수 없게 한다
# (spec/04_SECURITY_AND_DATA.md).
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

RUN useradd --create-home --uid 10001 appuser

COPY backend ./backend
COPY config ./config

USER appuser

# Worker 프로세스는 Wave 3에서 구현한다. 그때까지 이 이미지는 기동하지 않는다.
CMD ["sh", "-c", "echo 'worker entrypoint is not implemented yet (Wave 3)' >&2; exit 1"]
